AUTO_WORK_HOST=127.0.0.1
AUTO_WORK_PORT=3760
AUTO_WORK_DATA_DIR=./data
AUTO_WORK_WEB_DIST=./apps/web/dist
# 可省略；相对路径始终以仓库根目录为基准，而不是 Prisma schema 所在目录。
AUTO_WORK_DATABASE_URL=file:./data/auto-work.db
AUTO_WORK_REPOSITORY_ROOT=D:\\company
# auto 在 Windows 使用 DPAPI，在 Linux/Docker 使用 AES-256-GCM 密封文件。
AUTO_WORK_VAULT_BACKEND=auto
# 可省略；默认位于数据目录。备份/迁移时必须连同此密钥一起保留。
# AUTO_WORK_VAULT_KEY_FILE=./data/vault-master.key
AUTO_WORK_LOG_LEVEL=info
