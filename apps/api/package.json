{
  "name": "@auto-work/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "test": "pnpm run test:main && pnpm run test:windows-vault",
    "test:main": "vitest run --exclude test/windows-dpapi-vault.spec.ts --maxWorkers=1",
    "test:windows-vault": "vitest run test/windows-dpapi-vault.spec.ts --maxWorkers=1",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "node scripts/prisma-cli.mjs generate",
    "prisma:migrate": "node scripts/prisma-cli.mjs migrate dev",
    "prisma:deploy": "node scripts/prisma-cli.mjs migrate deploy",
    "prisma:status": "node scripts/prisma-cli.mjs migrate status",
    "prisma:validate": "node scripts/prisma-cli.mjs validate"
  },
  "dependencies": {
    "@auto-work/contracts": "workspace:*",
    "@auto-work/domain": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "8.3.0",
    "@nestjs/common": "^11.1.9",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.9",
    "@nestjs/platform-fastify": "^11.1.9",
    "@nestjs/schedule": "^6.0.1",
    "@prisma/client": "^6.19.0",
    "docx": "9.6.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.2",
    "prisma": "^6.19.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "yauzl": "^3.4.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.14",
    "@nestjs/testing": "^11.1.9",
    "@types/node": "^22.19.1",
    "@types/yauzl": "^2.10.3",
    "@vitest/coverage-v8": "^4.0.14",
    "jszip": "^3.10.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.14"
  }
}
