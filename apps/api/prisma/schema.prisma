  inputRefsJson             String                @default("[]") @map("input_refs_json")
  inputCategoriesJson       String                @default("[]") @map("input_categories_json")
  removedCategoriesJson     String                @default("[]") @map("removed_categories_json")
  sanitizedInputHash        String?               @map("sanitized_input_hash")
  sanitizedInputJson        String?               @map("sanitized_input_json")
  rawOutput                 String?               @map("raw_output")
  parsedOutputJson          String?               @map("parsed_output_json")
  protocol                  String
  model                     String
  providerRequestId         String?               @map("provider_request_id")
  stopReason                String?               @map("stop_reason")
  usageJson                 String                @default("{}") @map("usage_json")
  durationMs                Int?                  @map("duration_ms")
  status                    String
  errorCode                 String?               @map("error_code")
  securityBlocksJson        String                @default("[]") @map("security_blocks_json")
  adoptionStatus            String                @default("not_applicable") @map("adoption_status")
  decisionReason            String?               @map("decision_reason")
