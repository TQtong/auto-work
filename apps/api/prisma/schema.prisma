generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("AUTO_WORK_DATABASE_URL")
}

model SchemaMetadata {
  id                 Int      @id @default(1)
  applicationVersion String   @map("application_version")
  schemaChecksum     String   @map("schema_checksum")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("schema_metadata")
}

model InstanceLease {
  name       String   @id
  ownerId    String   @map("owner_id")
  acquiredAt DateTime @map("acquired_at")
  renewedAt  DateTime @map("renewed_at")
  expiresAt  DateTime @map("expires_at")

  @@map("instance_lease")
}

model UserProfile {
  id           String          @id
  windowsSid   String          @unique @map("windows_sid")
  displayName  String          @map("display_name")
  timezone     String          @default("Asia/Shanghai")
  workdayHours Int             @default(8) @map("workday_hours")
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  aliases      IdentityAlias[]

  @@map("user_profile")
}

model IdentityAlias {
  id              String      @id
  profileId       String      @map("profile_id")
  aliasType       String      @map("alias_type")
  value           String
  normalizedValue String      @map("normalized_value")
  source          String
  enabled         Boolean     @default(false)
  verifiedAt      DateTime?   @map("verified_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Restrict)

  @@unique([profileId, aliasType, normalizedValue])
  @@index([profileId, aliasType, enabled])
  @@map("identity_alias")
}

model Project {
  id             String       @id
  name           String
  alias          String?
  description    String?
  jiraProjectKey String?      @unique @map("jira_project_key")
  enabled        Boolean      @default(true)
  sortOrder      Int          @default(0) @map("sort_order")
  version        Int          @default(1)
  archivedAt     DateTime?    @map("archived_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  repositories   Repository[]
  tasks          Task[]
  evidences      Evidence[]

  @@index([enabled, archivedAt, sortOrder])
  @@map("project")
}

model Repository {
  id                 String         @id
  projectId          String?        @map("project_id")
  canonicalPath      String         @unique @map("canonical_path")
  realPathHash       String         @map("real_path_hash")
  identityHash       String         @map("identity_hash")
  displayName        String         @map("display_name")
  alias              String?
  gitDirKind         String         @map("git_dir_kind")
  remoteName         String?        @map("remote_name")
  remoteUrl          String?        @map("remote_url")
  remoteProtocol     String?        @map("remote_protocol")
  remoteHost         String?        @map("remote_host")
  remotePort         Int?           @map("remote_port")
  remotePath         String?        @map("remote_path")
  gitlabConnectionId String?        @map("gitlab_connection_id")
  gitlabProjectRef   String?        @map("gitlab_project_ref")
  baselineBranch     String?        @map("baseline_branch")
  whitelistStatus    String         @default("discovered") @map("whitelist_status")
  statusReason       String?        @map("status_reason")
  lastSeenAt         DateTime?      @map("last_seen_at")
  lastLocalRefreshAt DateTime?      @map("last_local_refresh_at")
  version            Int            @default(1)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  project            Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  snapshots          GitSnapshot[]
  gitBatchItems      GitBatchItem[]

  @@index([projectId, whitelistStatus])
  @@index([identityHash])
  @@index([remoteHost, remotePath])
  @@index([gitlabConnectionId, gitlabProjectRef])
  @@map("repository")
}

model GitBatch {
  id                  String         @id
  action              String
  parametersJson      String         @map("parameters_json")
  status              String         @default("draft")
  version             Int            @default(1)
  previewHash         String?        @map("preview_hash")
  previewedAt         DateTime?      @map("previewed_at")
  expiresAt           DateTime?      @map("expires_at")
  createdBy           String         @map("created_by")
  approvedBy          String?        @map("approved_by")
  approvedAt          DateTime?      @map("approved_at")
  approvalRequestHash String?        @map("approval_request_hash")
  executionStartedAt  DateTime?      @map("execution_started_at")
  executionEndedAt    DateTime?      @map("execution_ended_at")
  summaryJson         String         @default("{}") @map("summary_json")
  cancelReason        String?        @map("cancel_reason")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")
  items               GitBatchItem[]

  @@index([status, createdAt])
  @@index([createdBy, createdAt])
  @@map("git_batch")
}

model GitBatchItem {
  id                  String              @id
  batchId             String              @map("batch_id")
  repositoryId        String              @map("repository_id")
  ordinal             Int
  status              String              @default("queued")
  previewSnapshotJson String              @default("{}") @map("preview_snapshot_json")
  previewSnapshotHash String?             @map("preview_snapshot_hash")
  displayCommand      String?             @map("display_command")
  expectedChangesJson String              @default("[]") @map("expected_changes_json")
  warningsJson        String              @default("[]") @map("warnings_json")
  blockingReasonsJson String              @default("[]") @map("blocking_reasons_json")
  riskLevel           String              @default("information") @map("risk_level")
  executable          Boolean             @default(false)
  selected            Boolean             @default(false)
  executionCheckJson  String?             @map("execution_check_json")
  exitCode            Int?                @map("exit_code")
  resultCode          String?             @map("result_code")
  resultSummary       String?             @map("result_summary")
  postHeadSha         String?             @map("post_head_sha")
  outputSummary       String?             @map("output_summary")
  durationMs          Int?                @map("duration_ms")
  startedAt           DateTime?           @map("started_at")
  completedAt         DateTime?           @map("completed_at")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  batch               GitBatch            @relation(fields: [batchId], references: [id], onDelete: Restrict)
  repository          Repository          @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  events              GitOperationEvent[]

  @@unique([batchId, repositoryId])
  @@index([batchId, ordinal])
  @@index([repositoryId, createdAt])
  @@map("git_batch_item")
}

model GitOperationEvent {
  id              String       @id
  batchItemId     String       @map("batch_item_id")
  sequence        Int
  fromStatus      String?      @map("from_status")
  toStatus        String       @map("to_status")
  workerRequestId String?      @map("worker_request_id")
  errorCode       String?      @map("error_code")
  auditEventId    String?      @map("audit_event_id")
  occurredAt      DateTime     @default(now()) @map("occurred_at")
  item            GitBatchItem @relation(fields: [batchItemId], references: [id], onDelete: Restrict)

  @@unique([batchItemId, sequence])
  @@index([occurredAt])
  @@map("git_operation_event")
}

model GitSnapshot {
  id               String     @id
  repositoryId     String     @map("repository_id")
  headSha          String?    @map("head_sha")
  branchName       String?    @map("branch_name")
  detached         Boolean    @default(false)
  unborn           Boolean    @default(false)
  upstreamRef      String?    @map("upstream_ref")
  aheadCount       Int        @default(0) @map("ahead_count")
  behindCount      Int        @default(0) @map("behind_count")
  stagedCount      Int        @default(0) @map("staged_count")
  unstagedCount    Int        @default(0) @map("unstaged_count")
  untrackedCount   Int        @default(0) @map("untracked_count")
  conflictedCount  Int        @default(0) @map("conflicted_count")
  pathSummaryJson  String     @default("[]") @map("path_summary_json")
  stashCount       Int        @default(0) @map("stash_count")
  recentCommitJson String     @default("{}") @map("recent_commit_json")
  remotesJson      String     @default("[]") @map("remotes_json")
  outputTruncated  Boolean    @default(false) @map("output_truncated")
  status           String     @default("fresh")
  errorCode        String?    @map("error_code")
  errorSummary     String?    @map("error_summary")
  collectedAt      DateTime   @default(now()) @map("collected_at")
  repository       Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)

  @@index([repositoryId, collectedAt])
  @@map("git_snapshot")
}

model IntegrationConnection {
  id               String                @id
  type             String
  name             String
  baseUrl          String?               @map("base_url")
  credentialRef    String?               @map("credential_ref")
  credentialMask   String?               @map("credential_mask")
  enabled          Boolean               @default(true)
  status           String                @default("unknown")
  capabilitiesJson String                @default("{}") @map("capabilities_json")
  configJson       String                @default("{}") @map("config_json")
  lastTestedAt     DateTime?             @map("last_tested_at")
  lastSuccessAt    DateTime?             @map("last_success_at")
  disabledAt       DateTime?             @map("disabled_at")
  version          Int                   @default(1)
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  fieldMappings    FieldMappingVersion[]
  gitlabProjects   GitLabProject[]
  gitlabSyncRuns   GitLabSyncRun[]
  jiraTasks        Task[]
  jiraSyncCursors  SyncCursor[]
  jiraSyncRuns     JiraSyncRun[]

  @@index([type, enabled, status])
  @@map("integration_connection")
}

model GitLabProject {
  id                String                @id
  connectionId      String                @map("connection_id")
  externalId        String                @map("external_id")
  pathWithNamespace String                @map("path_with_namespace")
  name              String
  webUrl            String                @map("web_url")
  defaultBranch     String?               @map("default_branch")
  visibility        String
  archived          Boolean               @default(false)
  lastActivityAt    DateTime?             @map("last_activity_at")
  namespaceJson     String                @default("{}") @map("namespace_json")
  lastSeenRunId     String                @map("last_seen_run_id")
  stale             Boolean               @default(false)
  syncStatus        String                @default("unknown") @map("sync_status")
  syncError         String?               @map("sync_error")
  syncedAt          DateTime?             @map("synced_at")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")
  connection        IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  branches          GitLabBranch[]
  commits           GitLabCommit[]
  mergeRequests     GitLabMergeRequest[]
  pipelines         GitLabPipeline[]
  tags              GitLabTag[]
  releases          GitLabRelease[]
  members           GitLabProjectMember[]
  evidences         Evidence[]

  @@unique([connectionId, externalId])
  @@index([connectionId, pathWithNamespace])
  @@map("gitlab_project")
}

model GitLabBranch {
  id              String        @id
  gitlabProjectId String        @map("gitlab_project_id")
  name            String
  sha             String
  protected       Boolean       @default(false)
  defaultBranch   Boolean       @default(false) @map("default_branch")
  merged          Boolean       @default(false)
  webUrl          String?       @map("web_url")
  lastSeenRunId   String        @map("last_seen_run_id")
  stale           Boolean       @default(false)
  syncedAt        DateTime      @map("synced_at")
  project         GitLabProject @relation(fields: [gitlabProjectId], references: [id], onDelete: Restrict)

  @@unique([gitlabProjectId, name])
  @@index([gitlabProjectId, stale])
  @@map("gitlab_branch")
}

model GitLabCommit {
  id              String        @id
  gitlabProjectId String        @map("gitlab_project_id")
  sha             String
  shortSha        String?       @map("short_sha")
  title           String
  messageSummary  String?       @map("message_summary")
  authorName      String        @map("author_name")
  authorEmail     String        @map("author_email")
  committerName   String?       @map("committer_name")
  committerEmail  String?       @map("committer_email")
  authoredAt      DateTime?     @map("authored_at")
  committedAt     DateTime      @map("committed_at")
  webUrl          String?       @map("web_url")
  lastSeenRunId   String        @map("last_seen_run_id")
  syncedAt        DateTime      @map("synced_at")
  project         GitLabProject @relation(fields: [gitlabProjectId], references: [id], onDelete: Restrict)

  @@unique([gitlabProjectId, sha])
  @@index([gitlabProjectId, committedAt])
  @@map("gitlab_commit")
}

model GitLabMergeRequest {
  id                String        @id
  gitlabProjectId   String        @map("gitlab_project_id")
  externalId        String        @map("external_id")
  iid               Int
  title             String
  state             String
  sourceBranch      String        @map("source_branch")
  targetBranch      String        @map("target_branch")
  authorJson        String        @default("{}") @map("author_json")
  assigneesJson     String        @default("[]") @map("assignees_json")
  draft             Boolean       @default(false)
  mergedAt          DateTime?     @map("merged_at")
  closedAt          DateTime?     @map("closed_at")
  updatedExternalAt DateTime      @map("updated_external_at")
  webUrl            String        @map("web_url")
  lastSeenRunId     String        @map("last_seen_run_id")
  syncedAt          DateTime      @map("synced_at")
  project           GitLabProject @relation(fields: [gitlabProjectId], references: [id], onDelete: Restrict)

  @@unique([gitlabProjectId, externalId])
  @@index([gitlabProjectId, state, updatedExternalAt])
  @@index([gitlabProjectId, sourceBranch])
  @@map("gitlab_merge_request")
}

model GitLabPipeline {
  id                String        @id
  gitlabProjectId   String        @map("gitlab_project_id")
  externalId        String        @map("external_id")
  iid               Int?
  sha               String
  ref               String?
  status            String
  source            String?
  webUrl            String?       @map("web_url")
  createdExternalAt DateTime?     @map("created_external_at")
  updatedExternalAt DateTime?     @map("updated_external_at")
  lastSeenRunId     String        @map("last_seen_run_id")
  syncedAt          DateTime      @map("synced_at")
  project           GitLabProject @relation(fields: [gitlabProjectId], references: [id], onDelete: Restrict)

  @@unique([gitlabProjectId, externalId])
  @@index([gitlabProjectId, updatedExternalAt])
  @@index([gitlabProjectId, sha])
  @@map("gitlab_pipeline")
}

model GitLabTag {
  id                String        @id
  gitlabProjectId   String        @map("gitlab_project_id")
  name              String
  targetSha         String        @map("target_sha")
  messageSummary    String?       @map("message_summary")
  protected         Boolean       @default(false)
  webUrl            String?       @map("web_url")
  createdExternalAt DateTime?     @map("created_external_at")
  lastSeenRunId     String        @map("last_seen_run_id")
  stale             Boolean       @default(false)
  syncedAt          DateTime      @map("synced_at")
  project           GitLabProject @relation(fields: [gitlabProjectId], references: [id], onDelete: Restrict)

  @@unique([gitlabProjectId, name])
  @@index([gitlabProjectId, stale])
  @@map("gitlab_tag")
}

model GitLabRelease {
  id                 String        @id
  gitlabProjectId    String        @map("gitlab_project_id")
  tagName            String        @map("tag_name")
  name               String?
  descriptionSummary String?       @map("description_summary")
  releasedAt         DateTime?     @map("released_at")
  createdExternalAt  DateTime?     @map("created_external_at")
  upcomingRelease    Boolean       @default(false) @map("upcoming_release")
  webUrl             String?       @map("web_url")
  assetsJson         String        @default("{}") @map("assets_json")
  lastSeenRunId      String        @map("last_seen_run_id")
  stale              Boolean       @default(false)
  syncedAt           DateTime      @map("synced_at")
  project            GitLabProject @relation(fields: [gitlabProjectId], references: [id], onDelete: Restrict)

  @@unique([gitlabProjectId, tagName])
  @@index([gitlabProjectId, stale])
  @@map("gitlab_release")
}

model GitLabProjectMember {
  id              String        @id
  gitlabProjectId String        @map("gitlab_project_id")
  externalUserId  String        @map("external_user_id")
  username        String
  name            String
  state           String?
  accessLevel     Int           @map("access_level")
  webUrl          String?       @map("web_url")
  avatarUrl       String?       @map("avatar_url")
  expiresAt       DateTime?     @map("expires_at")
  lastSeenRunId   String        @map("last_seen_run_id")
  stale           Boolean       @default(false)
  syncedAt        DateTime      @map("synced_at")
  project         GitLabProject @relation(fields: [gitlabProjectId], references: [id], onDelete: Restrict)

  @@unique([gitlabProjectId, externalUserId])
  @@index([gitlabProjectId, stale])
  @@map("gitlab_project_member")
}

model GitLabSyncRun {
  id           String                @id
  connectionId String                @map("connection_id")
  status       String
  scopeJson    String                @map("scope_json")
  countsJson   String                @default("{}") @map("counts_json")
  errorCode    String?               @map("error_code")
  errorSummary String?               @map("error_summary")
  startedAt    DateTime              @map("started_at")
  completedAt  DateTime?             @map("completed_at")
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@index([connectionId, startedAt])
  @@map("gitlab_sync_run")
}

model FieldMappingVersion {
  id                     String                  @id
  connectionId           String                  @map("connection_id")
  versionNo              Int                     @map("version_no")
  effectiveAt            DateTime                @default(now()) @map("effective_at")
  fieldMappingsJson      String                  @map("field_mappings_json")
  statusMappingsJson     String                  @default("{}") @map("status_mappings_json")
  parserRulesJson        String                  @default("{}") @map("parser_rules_json")
  validationSummaryJson  String                  @default("{}") @map("validation_summary_json")
  createdBy              String                  @map("created_by")
  createdAt              DateTime                @default(now()) @map("created_at")
  connection             IntegrationConnection   @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  tasks                  Task[]
  taskSourceObservations TaskSourceObservation[]
  jiraSyncRuns           JiraSyncRun[]

  @@unique([connectionId, versionNo])
  @@map("field_mapping_version")
}

model Task {
  id                       String                  @id
  sourceStableKey          String?                 @unique @map("source_stable_key")
  connectionId             String?                 @map("connection_id")
  projectId                String?                 @map("project_id")
  primarySource            String                  @map("primary_source")
  externalId               String?                 @map("external_id")
  issueKey                 String?                 @map("issue_key")
  projectKey               String?                 @map("project_key")
  issueType                String?                 @map("issue_type")
  parentTaskId             String?                 @map("parent_task_id")
  parentIssueKey           String?                 @map("parent_issue_key")
  parentTitle              String?                 @map("parent_title")
  title                    String
  descriptionPolicy        String                  @default("not_persisted") @map("description_policy")
  priority                 String?
  assigneeExternalId       String?                 @map("assignee_external_id")
  assigneeName             String?                 @map("assignee_name")
  isCurrentUser            Boolean                 @default(false) @map("is_current_user")
  rawStatusId              String?                 @map("raw_status_id")
  rawStatusName            String?                 @map("raw_status_name")
  normalizedStatus         String                  @default("other") @map("normalized_status")
  plannedStartDate         String?                 @map("planned_start_date")
  dueDate                  String?                 @map("due_date")
  originalEstimateSeconds  Int?                    @map("original_estimate_seconds")
  remainingEstimateSeconds Int?                    @map("remaining_estimate_seconds")
  timeSpentSeconds         Int?                    @map("time_spent_seconds")
  sprintIdsJson            String                  @default("[]") @map("sprint_ids_json")
  labelsJson               String                  @default("[]") @map("labels_json")
  componentsJson           String                  @default("[]") @map("components_json")
  externalUpdatedAt        DateTime?               @map("external_updated_at")
  lastObservedAt           DateTime                @map("last_observed_at")
  visibilityState          String                  @default("visible") @map("visibility_state")
  mappingVersionId         String?                 @map("mapping_version_id")
  version                  Int                     @default(1)
  createdAt                DateTime                @default(now()) @map("created_at")
  updatedAt                DateTime                @updatedAt @map("updated_at")
  connection               IntegrationConnection?  @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  project                  Project?                @relation(fields: [projectId], references: [id], onDelete: Restrict)
  mappingVersion           FieldMappingVersion?    @relation(fields: [mappingVersionId], references: [id], onDelete: Restrict)
  parentTask               Task?                   @relation("TaskHierarchy", fields: [parentTaskId], references: [id], onDelete: Restrict)
  childTasks               Task[]                  @relation("TaskHierarchy")
  statusEvents             TaskStatusEvent[]
  sourceObservations       TaskSourceObservation[]
  matchedExcelRows         ExcelImportRow[]        @relation("ExcelMatchedTask")
  committedExcelRows       ExcelImportRow[]        @relation("ExcelCommittedTask")
  fieldProvenances         TaskFieldProvenance[]
  evidenceLinks            EvidenceLink[]

  @@unique([connectionId, issueKey])
  @@index([projectId, normalizedStatus, dueDate])
  @@index([connectionId, visibilityState, externalUpdatedAt])
  @@index([parentTaskId])
  @@map("task")
}

model TaskStatusEvent {
  id                    String                @id
  taskId                String                @map("task_id")
  fromRawStatusId       String?               @map("from_raw_status_id")
  fromRawStatusName     String?               @map("from_raw_status_name")
  fromNormalizedStatus  String?               @map("from_normalized_status")
  toRawStatusId         String?               @map("to_raw_status_id")
  toRawStatusName       String?               @map("to_raw_status_name")
  toNormalizedStatus    String                @map("to_normalized_status")
  effectiveAt           DateTime?             @map("effective_at")
  observedAt            DateTime              @map("observed_at")
  observedIntervalStart DateTime?             @map("observed_interval_start")
  sourceObservationId   String                @map("source_observation_id")
  task                  Task                  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sourceObservation     TaskSourceObservation @relation(fields: [sourceObservationId], references: [id], onDelete: Restrict)

  @@unique([taskId, sourceObservationId])
  @@index([taskId, observedAt])
  @@map("task_status_event")
}

model TaskSourceObservation {
  id               String                @id
  taskId           String                @map("task_id")
  sourceType       String                @map("source_type")
  sourceUpdatedAt  DateTime?             @map("source_updated_at")
  contentHash      String                @map("content_hash")
  fieldsJson       String                @map("fields_json")
  warningsJson     String                @default("[]") @map("warnings_json")
  syncRunId        String?               @map("sync_run_id")
  mappingVersionId String?               @map("mapping_version_id")
  observedAt       DateTime              @map("observed_at")
  task             Task                  @relation(fields: [taskId], references: [id], onDelete: Restrict)
  syncRun          JiraSyncRun?          @relation(fields: [syncRunId], references: [id], onDelete: Restrict)
  mappingVersion   FieldMappingVersion?  @relation(fields: [mappingVersionId], references: [id], onDelete: Restrict)
  statusEvents     TaskStatusEvent[]
  fieldProvenances TaskFieldProvenance[]
  excelImportRows  ExcelImportRow[]      @relation("ExcelRowObservation")

  @@unique([taskId, sourceUpdatedAt, contentHash])
  @@index([syncRunId])
  @@index([taskId, observedAt])
  @@map("task_source_observation")
}

model SyncCursor {
  id               String                @id
  connectionId     String                @map("connection_id")
  scope            String
  lastUpdatedAt    DateTime?             @map("last_updated_at")
  lastTiebreaker   String?               @map("last_tiebreaker")
  overlapSeconds   Int                   @default(120) @map("overlap_seconds")
  lastSuccessRunId String?               @map("last_success_run_id")
  version          Int                   @default(1)
  updatedAt        DateTime              @updatedAt @map("updated_at")
  connection       IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)

  @@unique([connectionId, scope])
  @@map("sync_cursor")
}

model JiraSyncRun {
  id               String                  @id
  connectionId     String                  @map("connection_id")
  scope            String
  trigger          String
  status           String
  mappingVersionId String                  @map("mapping_version_id")
  queryHash        String                  @map("query_hash")
  requestJson      String                  @default("{}") @map("request_json")
  pageCount        Int                     @default(0) @map("page_count")
  readCount        Int                     @default(0) @map("read_count")
  createdCount     Int                     @default(0) @map("created_count")
  updatedCount     Int                     @default(0) @map("updated_count")
  unchangedCount   Int                     @default(0) @map("unchanged_count")
  errorCount       Int                     @default(0) @map("error_count")
  errorCode        String?                 @map("error_code")
  errorSummary     String?                 @map("error_summary")
  cursorBeforeJson String                  @default("{}") @map("cursor_before_json")
  cursorAfterJson  String                  @default("{}") @map("cursor_after_json")
  startedAt        DateTime                @map("started_at")
  completedAt      DateTime?               @map("completed_at")
  connection       IntegrationConnection   @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  mappingVersion   FieldMappingVersion     @relation(fields: [mappingVersionId], references: [id], onDelete: Restrict)
  taskObservations TaskSourceObservation[]

  @@index([connectionId, startedAt])
  @@index([status, startedAt])
  @@map("jira_sync_run")
}

model ExcelImport {
  id                 String           @id
  fileName           String           @map("file_name")
  fileSha256         String           @map("file_sha256")
  fileSizeBytes      Int              @map("file_size_bytes")
  parserVersion      String           @map("parser_version")
  dateSystem         String           @map("date_system")
  workdayHours       Float            @default(8) @map("workday_hours")
  status             String           @default("preview_ready")
  sheetSummaryJson   String           @default("[]") @map("sheet_summary_json")
  ignoredColumnsJson String           @default("[]") @map("ignored_columns_json")
  diagnosticsJson    String           @default("[]") @map("diagnostics_json")
  blockingCount      Int              @default(0) @map("blocking_count")
  conflictCount      Int              @default(0) @map("conflict_count")
  warningCount       Int              @default(0) @map("warning_count")
  infoCount          Int              @default(0) @map("info_count")
  taskRowCount       Int              @default(0) @map("task_row_count")
  containerRowCount  Int              @default(0) @map("container_row_count")
  errorCode          String?          @map("error_code")
  errorSummary       String?          @map("error_summary")
  createdBy          String           @map("created_by")
  committedAt        DateTime?        @map("committed_at")
  commitSummaryJson  String           @default("{}") @map("commit_summary_json")
  version            Int              @default(1)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  rows               ExcelImportRow[]

  @@unique([fileSha256, parserVersion])
  @@index([status, createdAt])
  @@map("excel_import")
}

model ExcelImportRow {
  id                  String                 @id
  importId            String                 @map("import_id")
  sheetName           String                 @map("sheet_name")
  rowNumber           Int                    @map("row_number")
  rowKind             String                 @map("row_kind")
  rowFingerprint      String                 @map("row_fingerprint")
  rawJson             String                 @map("raw_json")
  normalizedJson      String                 @map("normalized_json")
  diagnosticsJson     String                 @default("[]") @map("diagnostics_json")
  candidatesJson      String                 @default("[]") @map("candidates_json")
  resolutionJson      String                 @default("{}") @map("resolution_json")
  proposedAction      String                 @map("proposed_action")
  commitStatus        String                 @default("pending") @map("commit_status")
  matchedTaskId       String?                @map("matched_task_id")
  committedTaskId     String?                @map("committed_task_id")
  sourceObservationId String?                @map("source_observation_id")
  version             Int                    @default(1)
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")
  import              ExcelImport            @relation(fields: [importId], references: [id], onDelete: Restrict)
  matchedTask         Task?                  @relation("ExcelMatchedTask", fields: [matchedTaskId], references: [id], onDelete: Restrict)
  committedTask       Task?                  @relation("ExcelCommittedTask", fields: [committedTaskId], references: [id], onDelete: Restrict)
  sourceObservation   TaskSourceObservation? @relation("ExcelRowObservation", fields: [sourceObservationId], references: [id], onDelete: Restrict)
  fieldProvenances    TaskFieldProvenance[]

  @@unique([importId, sheetName, rowNumber])
  @@index([importId, proposedAction, commitStatus])
  @@index([rowFingerprint])
  @@map("excel_import_row")
}

model TaskFieldProvenance {
  id                  String                 @id
  taskId              String                 @map("task_id")
  fieldName           String                 @map("field_name")
  sourceType          String                 @map("source_type")
  decision            String
  valueJson           String                 @map("value_json")
  sourceObservationId String?                @map("source_observation_id")
  excelImportRowId    String?                @map("excel_import_row_id")
  reason              String?
  active              Boolean                @default(false)
  effectiveAt         DateTime               @default(now()) @map("effective_at")
  supersededAt        DateTime?              @map("superseded_at")
  createdAt           DateTime               @default(now()) @map("created_at")
  task                Task                   @relation(fields: [taskId], references: [id], onDelete: Restrict)
  sourceObservation   TaskSourceObservation? @relation(fields: [sourceObservationId], references: [id], onDelete: Restrict)
  excelImportRow      ExcelImportRow?        @relation(fields: [excelImportRowId], references: [id], onDelete: Restrict)

  @@index([taskId, fieldName, active])
  @@index([excelImportRowId])
  @@map("task_field_provenance")
}

model Evidence {
  id                String         @id
  sourceType        String         @map("source_type")
  sourceInternalId  String         @map("source_internal_id")
  sourceExternalKey String         @map("source_external_key")
  gitlabProjectId   String?        @map("gitlab_project_id")
  projectId         String?        @map("project_id")
  eventAt           DateTime?      @map("event_at")
  title             String
  url               String?
  contentHash       String         @map("content_hash")
  availabilityState String         @default("available") @map("availability_state")
  metadataJson      String         @default("{}") @map("metadata_json")
  sourceSyncedAt    DateTime?      @map("source_synced_at")
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  gitlabProject     GitLabProject? @relation(fields: [gitlabProjectId], references: [id], onDelete: Restrict)
  project           Project?       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  links             EvidenceLink[]

  @@unique([sourceType, sourceInternalId])
  @@index([projectId, eventAt])
  @@index([gitlabProjectId, sourceType, availabilityState])
  @@index([availabilityState, updatedAt])
  @@map("evidence")
}

model EvidenceLink {
  id                String              @id
  targetType        String              @map("target_type")
  targetId          String              @map("target_id")
  taskId            String?             @map("task_id")
  evidenceId        String              @map("evidence_id")
  method            String
  confidence        Float
  status            String              @default("suggested")
  explanation       String
  matchedValue      String?             @map("matched_value")
  ruleVersion       String              @map("rule_version")
  sourceContentHash String              @map("source_content_hash")
  decisionReason    String?             @map("decision_reason")
  confirmedBy       String?             @map("confirmed_by")
  confirmedAt       DateTime?           @map("confirmed_at")
  rejectedBy        String?             @map("rejected_by")
  rejectedAt        DateTime?           @map("rejected_at")
  expiresAt         DateTime?           @map("expires_at")
  expiredAt         DateTime?           @map("expired_at")
  revalidationState String              @default("valid") @map("revalidation_state")
  version           Int                 @default(1)
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  task              Task?               @relation(fields: [taskId], references: [id], onDelete: Restrict)
  evidence          Evidence            @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  events            EvidenceLinkEvent[]

  @@unique([targetType, targetId, evidenceId])
  @@index([taskId, status, confidence])
  @@index([evidenceId, status])
  @@index([status, expiresAt])
  @@map("evidence_link")
}

model EvidenceLinkEvent {
  id                String       @id
  evidenceLinkId    String       @map("evidence_link_id")
  sequence          Int
  action            String
  fromStatus        String?      @map("from_status")
  toStatus          String       @map("to_status")
  actorType         String       @map("actor_type")
  actorId           String       @map("actor_id")
  reason            String?
  sourceContentHash String       @map("source_content_hash")
  ruleVersion       String       @map("rule_version")
  occurredAt        DateTime     @default(now()) @map("occurred_at")
  link              EvidenceLink @relation(fields: [evidenceLinkId], references: [id], onDelete: Restrict)

  @@unique([evidenceLinkId, sequence])
  @@index([occurredAt])
  @@map("evidence_link_event")
}

model IdempotencyRecord {
  id             String    @id
  actorId        String    @map("actor_id")
  route          String
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  state          String    @default("processing")
  httpStatus     Int?      @map("http_status")
  responseJson   String?   @map("response_json")
  errorCode      String?   @map("error_code")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([actorId, route, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_record")
}

model Job {
  id              String    @id
  type            String
  payloadRef      String?   @map("payload_ref")
  payloadSummary  String    @default("{}") @map("payload_summary")
  priority        Int       @default(100)
  status          String    @default("queued")
  progress        Int       @default(0)
  scheduledAt     DateTime  @map("scheduled_at")
  leaseOwner      String?   @map("lease_owner")
  leaseUntil      DateTime? @map("lease_until")
  attemptCount    Int       @default(0) @map("attempt_count")
  maxAttempts     Int       @default(3) @map("max_attempts")
  dedupeKey       String?   @map("dedupe_key")
  cancelRequested Boolean   @default(false) @map("cancel_requested")
  lastErrorCode   String?   @map("last_error_code")
  lastError       String?   @map("last_error")
  resultJson      String?   @map("result_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, scheduledAt, priority])
  @@index([dedupeKey, status])
  @@map("job")
}

model AuditEvent {
  eventId           String   @id @map("event_id")
  occurredAt        DateTime @default(now()) @map("occurred_at")
  actorType         String   @map("actor_type")
  actorId           String   @map("actor_id")
  action            String
  targetType        String   @map("target_type")
  targetId          String   @map("target_id")
  correlationId     String   @map("correlation_id")
  approvalId        String?  @map("approval_id")
  outcome           String
  beforeSummaryHash String?  @map("before_summary_hash")
  afterSummaryHash  String?  @map("after_summary_hash")
  clientSessionHash String   @map("client_session_hash")
  errorCode         String?  @map("error_code")

  @@index([occurredAt])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@map("audit_event")
}

model AppEventLog {
  id             String   @id
  timestamp      DateTime @default(now())
  level          String
  component      String
  eventName      String   @map("event_name")
  correlationId  String?  @map("correlation_id")
  operationId    String?  @map("operation_id")
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  durationMs     Int?     @map("duration_ms")
  outcome        String?
  errorCode      String?  @map("error_code")
  attributesJson String   @default("{}") @map("attributes_json")

  @@index([timestamp])
  @@index([correlationId])
  @@map("app_event_log")
}

model BackupArtifact {
  id             String    @id
  fileName       String?   @map("file_name")
  path           String?
  sha256         String?
  sizeBytes      BigInt?   @map("size_bytes")
  status         String
  schemaChecksum String?   @map("schema_checksum")
  verifiedAt     DateTime? @map("verified_at")
  errorCode      String?   @map("error_code")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backup_artifact")
}
