/// 每个交付意图固定到一次有效确认、一个外部通道和一个连接；正文仍只保存在不可变周报版本中。
model DeliveryIntent {
  id                  String                   @id
  reportId            String                   @map("report_id")
  confirmationId      String                   @map("confirmation_id")
  confirmedVersionId  String                   @map("confirmed_version_id")
  connectionId        String                   @map("connection_id")
  channel             String
  idempotencyRecordId String                   @map("idempotency_record_id")
  requestHash         String                   @map("request_hash")
  targetSummaryJson   String                   @default("{}") @map("target_summary_json")
  status              String                   @default("pending")
  jobId               String?                  @unique @map("job_id")
  externalId          String?                  @map("external_id")
  externalUrl         String?                  @map("external_url")
  providerRequestId   String?                  @map("provider_request_id")
  attemptCount        Int                      @default(0) @map("attempt_count")
  lastAttemptAt       DateTime?                @map("last_attempt_at")
  lastErrorCode       String?                  @map("last_error_code")
  lastErrorSummary    String?                  @map("last_error_summary")
  recoveryStatus      String                   @default("not_required") @map("recovery_status")
  lastRecoveryAt      DateTime?                @map("last_recovery_at")
  resolvedBy          String?                  @map("resolved_by")
  resolvedAt          DateTime?                @map("resolved_at")
  resolutionReason    String?                  @map("resolution_reason")
  completedAt         DateTime?                @map("completed_at")
  version             Int                      @default(1)
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")
  report              WeeklyReport             @relation(fields: [reportId], references: [id], onDelete: Restrict)
  confirmation        WeeklyReportConfirmation @relation(fields: [confirmationId], references: [id], onDelete: Restrict)
  confirmedVersion    WeeklyReportVersion      @relation(fields: [confirmedVersionId], references: [id], onDelete: Restrict)
  connection          IntegrationConnection    @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  attempts            DeliveryAttempt[]
  recoveryChecks      DeliveryRecoveryCheck[]
  robotNotification   RobotNotification?

  @@unique([reportId, confirmationId, channel, connectionId])
  @@index([reportId, channel, createdAt])
  @@index([status, updatedAt])
  @@map("delivery_intent")
}

/// 每一次外部查询和人工裁决都单独留痕；只保存匹配摘要与哈希，不复制周报正文或凭证。
model DeliveryRecoveryCheck {
  id                String         @id
  intentId          String         @map("intent_id")
  sequenceNo        Int            @map("sequence_no")
  mode              String
  outcome           String
  queryWindowStart  DateTime?      @map("query_window_start")
  queryWindowEnd    DateTime?      @map("query_window_end")
  candidateCount    Int            @default(0) @map("candidate_count")
  exactMatchCount   Int            @default(0) @map("exact_match_count")
  matchedExternalId String?        @map("matched_external_id")
  evidenceHash      String         @map("evidence_hash")
  summaryJson       String         @default("{}") @map("summary_json")
  actorId           String         @map("actor_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  intent            DeliveryIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@unique([intentId, sequenceNo])
  @@index([intentId, createdAt])
  @@map("delivery_recovery_check")
}

/// attempt 只记录请求/响应摘要、错误分类和外部标识，不复制秘密或六字段正文。
model DeliveryAttempt {
  id                  String         @id
  intentId            String         @map("intent_id")
  attemptNo           Int            @map("attempt_no")
  requestSummaryHash  String         @map("request_summary_hash")
  status              String         @default("running")
  httpStatus          Int?           @map("http_status")
  providerErrorCode   String?        @map("provider_error_code")
  providerRequestId   String?        @map("provider_request_id")
  externalId          String?        @map("external_id")
  externalUrl         String?        @map("external_url")
  responseSummaryJson String         @default("{}") @map("response_summary_json")
  retryAt             DateTime?      @map("retry_at")
  startedAt           DateTime       @default(now()) @map("started_at")
  completedAt         DateTime?      @map("completed_at")
  intent              DeliveryIntent @relation(fields: [intentId], references: [id], onDelete: Restrict)

  @@unique([intentId, attemptNo])
  @@index([status, startedAt])
  @@map("delivery_attempt")
}

/// 机器人业务通知使用独立账本；只保存去重、调度和非敏感结果，不复制完整周报正文或凭证。
model RobotNotification {
  id                    String                @id
  reportId              String                @map("report_id")
  connectionId          String                @map("connection_id")
  deliveryIntentId      String?               @unique @map("delivery_intent_id")
  notificationType      String                @map("notification_type")
  businessObjectKey     String                @map("business_object_key")
  stateVersion          Int                   @map("state_version")
  dedupeKey             String                @unique @map("dedupe_key")
  contentHash           String                @map("content_hash")
  messageFactsJson      String                @default("{}") @map("message_facts_json")
  status                String                @default("pending")
  quietWindowStartedAt  DateTime              @map("quiet_window_started_at")
  quietWindowEndsAt     DateTime              @map("quiet_window_ends_at")
  coalescedCount        Int                   @default(0) @map("coalesced_count")
  scheduledFor          DateTime              @map("scheduled_for")
  jobId                 String?               @unique @map("job_id")
  lastAttemptAt         DateTime?             @map("last_attempt_at")
  sentAt                DateTime?             @map("sent_at")
  skippedAt             DateTime?             @map("skipped_at")
  skipReason            String?               @map("skip_reason")
  providerRequestId     String?               @map("provider_request_id")
  providerCallCount     Int                   @default(0) @map("provider_call_count")
  retryDelaysJson       String                @default("[]") @map("retry_delays_json")
  lastErrorCode         String?               @map("last_error_code")
  lastErrorSummary      String?               @map("last_error_summary")
  version               Int                   @default(1)
  createdAt             DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")
  report                WeeklyReport          @relation(fields: [reportId], references: [id], onDelete: Restrict)
  connection            IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Restrict)
  deliveryIntent        DeliveryIntent?       @relation(fields: [deliveryIntentId], references: [id], onDelete: Restrict)

  @@index([reportId, notificationType, createdAt])
  @@index([status, scheduledFor])
  @@index([businessObjectKey, notificationType, contentHash, quietWindowEndsAt])
  @@map("robot_notification")
}

model ReportSourceSnapshot {
  id                        String                @id
  reportId                  String                @map("report_id")
  periodStart               String                @map("period_start")
  periodEnd                 String                @map("period_end")
  reportDate                String                @map("report_date")
  timezone                  String
  calendarVersionId         String?               @map("calendar_version_id")
  profileId                 String                @map("profile_id")
  profileVersion            Int                   @map("profile_version")
  jiraQueryJson             String                @default("{}") @map("jira_query_json")
  jiraSyncRunIdsJson        String                @default("[]") @map("jira_sync_run_ids_json")
  taskFactsJson             String                @map("task_facts_json")
  evidenceFactsJson         String                @map("evidence_facts_json")
  manualInputsJson          String                @default("[]") @map("manual_inputs_json")
  freshnessPolicyJson       String                @map("freshness_policy_json")
  warningsJson              String                @default("[]") @map("warnings_json")
  ruleVersion               String                @map("rule_version")
  templateMappingVersionId  String?               @map("template_mapping_version_id")
  sanitizationPolicyVersion String                @map("sanitization_policy_version")
  generationHash            String                @map("generation_hash")
  sourceContentHash         String                @map("source_content_hash")
  createdBy                 String                @map("created_by")
  createdAt                 DateTime              @default(now()) @map("created_at")
  report                    WeeklyReport          @relation(fields: [reportId], references: [id], onDelete: Restrict)
  calendarVersion           WorkCalendarVersion?  @relation(fields: [calendarVersionId], references: [id], onDelete: Restrict)
  profile                   UserProfile           @relation(fields: [profileId], references: [id], onDelete: Restrict)
  versions                  WeeklyReportVersion[]
  sourceLinks               ReportSourceLink[]

  @@unique([reportId, generationHash])
  @@index([profileId, periodStart, periodEnd])
  @@map("report_source_snapshot")
}

model ReportSourceLink {
  id                String               @id
  snapshotId        String               @map("snapshot_id")
  versionId         String               @map("version_id")
  fieldName         String               @map("field_name")
  blockId           String               @map("block_id")
  sourceType        String               @map("source_type")
  sourceId          String               @map("source_id")
  taskId            String?              @map("task_id")
  evidenceId        String?              @map("evidence_id")
  sourceContentHash String               @map("source_content_hash")
  sourceSummaryJson String               @map("source_summary_json")
  createdAt         DateTime             @default(now()) @map("created_at")
  snapshot          ReportSourceSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Restrict)
  version           WeeklyReportVersion  @relation(fields: [versionId], references: [id], onDelete: Restrict)
  task              Task?                @relation(fields: [taskId], references: [id], onDelete: Restrict)
  evidence          Evidence?            @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  @@unique([versionId, fieldName, blockId, sourceType, sourceId])
  @@index([snapshotId])
  @@index([sourceType, sourceId])
  @@map("report_source_link")
}

model IdempotencyRecord {
  id             String    @id
  actorId        String    @map("actor_id")
  route          String
  idempotencyKey String    @map("idempotency_key")
  requestHash    String    @map("request_hash")
  state          String    @default("processing")
  httpStatus     Int?      @map("http_status")
  responseJson   String?   @map("response_json")
  errorCode      String?   @map("error_code")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([actorId, route, idempotencyKey])
  @@index([expiresAt])
  @@map("idempotency_record")
}

model Job {
  id              String    @id
  type            String
  payloadRef      String?   @map("payload_ref")
  payloadSummary  String    @default("{}") @map("payload_summary")
  priority        Int       @default(100)
  status          String    @default("queued")
  progress        Int       @default(0)
  scheduledAt     DateTime  @map("scheduled_at")
  leaseOwner      String?   @map("lease_owner")
  leaseUntil      DateTime? @map("lease_until")
  attemptCount    Int       @default(0) @map("attempt_count")
  maxAttempts     Int       @default(3) @map("max_attempts")
  dedupeKey       String?   @map("dedupe_key")
  cancelRequested Boolean   @default(false) @map("cancel_requested")
  lastErrorCode   String?   @map("last_error_code")
  lastError       String?   @map("last_error")
  resultJson      String?   @map("result_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status, scheduledAt, priority])
  @@index([dedupeKey, status])
  @@map("job")
}

model AuditEvent {
  eventId           String   @id @map("event_id")
  occurredAt        DateTime @default(now()) @map("occurred_at")
  actorType         String   @map("actor_type")
  actorId           String   @map("actor_id")
  action            String
  targetType        String   @map("target_type")
  targetId          String   @map("target_id")
  correlationId     String   @map("correlation_id")
  approvalId        String?  @map("approval_id")
  outcome           String
  beforeSummaryHash String?  @map("before_summary_hash")
  afterSummaryHash  String?  @map("after_summary_hash")
  clientSessionHash String   @map("client_session_hash")
  errorCode         String?  @map("error_code")

  @@index([occurredAt])
  @@index([targetType, targetId])
  @@index([correlationId])
  @@map("audit_event")
}

model AppEventLog {
  id             String   @id
  timestamp      DateTime @default(now())
  level          String
  component      String
  eventName      String   @map("event_name")
  correlationId  String?  @map("correlation_id")
  operationId    String?  @map("operation_id")
  targetType     String?  @map("target_type")
  targetId       String?  @map("target_id")
  durationMs     Int?     @map("duration_ms")
  outcome        String?
  errorCode      String?  @map("error_code")
  attributesJson String   @default("{}") @map("attributes_json")

  @@index([timestamp])
  @@index([correlationId])
  @@map("app_event_log")
}

model BackupArtifact {
  id             String    @id
  fileName       String?   @map("file_name")
  path           String?
  sha256         String?
  sizeBytes      BigInt?   @map("size_bytes")
  status         String
  schemaChecksum String?   @map("schema_checksum")
  verifiedAt     DateTime? @map("verified_at")
  errorCode      String?   @map("error_code")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backup_artifact")
}
