# 宿主机浏览器访问端口；容器内外使用同一端口以满足严格 Host/Origin 校验。
AUTO_WORK_PORT=3760

# 需要扫描和操作的宿主机 Git 仓库根目录。Windows Docker Desktop 推荐使用正斜杠。
AUTO_WORK_REPOSITORY_PATH=D:/company
AUTO_WORK_DINGTALK_DESKTOP_BRIDGE_HOST_PATH=C:/Users/WIN11/AppData/Local/AutoWork/desktop-bridge

# 镜像标签和日志级别可按需调整。
AUTO_WORK_IMAGE_TAG=local
AUTO_WORK_LOG_LEVEL=info
